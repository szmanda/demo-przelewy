<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Payment Gateway Demo | Nexi Group{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>💳</text></svg>">
    
    <!-- Tailwind CSS & Font Awesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    {% block stylesheets %}
    {% endblock %}
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen font-sans antialiased">
    <header class="border-b border-slate-200 bg-white/95 backdrop-blur sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-3.5 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-emerald-800 text-white flex items-center justify-center font-bold text-lg shadow-sm">
                    P24
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight text-slate-900">Payment Gateway Demo</h1>
                    <p class="text-xs text-slate-500">Przelewy24 & Polskie ePłatności | Nexi Group</p>
                </div>
            </div>
            <div class="flex items-center space-x-2.5 text-xs font-mono">
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-600 mr-1.5 animate-pulse"></span>
                    Symfony 7.4
                </span>
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 text-slate-700 border border-slate-200">
                    PostgreSQL 16
                </span>
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-amber-50 text-amber-800 border border-amber-200">
                    RabbitMQ 3
                </span>
                <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-sky-50 text-sky-800 border border-sky-200">
                    Elasticsearch 8.15
                </span>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8">
        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}
    {% endblock %}
</body>
</html>
